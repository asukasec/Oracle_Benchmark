# ============================================
# Oracle Benchmark API Keys Configuration
# ============================================
# 说明：只需配置你要测试的模型对应的API Key
# 不需要测试的模型可以保持为 "xxx" 或删除该行

# OpenAI Models (GPT, O-series)
OPENAI_API_KEY="xxx"

# Anthropic Models (Claude)
ANTHROPIC_API_KEY="xxx"

# Google Models (Gemini)
GEMINI_API_KEY="xxx"

# Alibaba Models (Qwen via API)
ALIBABA_API_KEY="xxx"

# DeepSeek Models
DEEPSEEK_API_KEY="xxx"

# OpenRouter (for Llama via API)
OPENROUTER_API_KEY="xxx"

# ============================================
# Local Model Configuration (本地模型配置)
# ============================================
# 本地模型存放路径（支持相对路径和绝对路径）
LOCAL_MODEL_PATH="./models"

# 或者直接指定HuggingFace模型ID（将自动下载）
# 留空则使用LOCAL_MODEL_PATH路径下的模型

# HuggingFace镜像站点（可选，加速模型下载）
# HF_ENDPOINT="https://hf-mirror.com"

# GPU配置（可选）
# CUDA_VISIBLE_DEVICES="0"  # 指定使用的GPU

# 量化配置（可选，用于大模型）
# USE_4BIT_QUANTIZATION="true"
# USE_8BIT_QUANTIZATION="false"